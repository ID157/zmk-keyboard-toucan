config TOUCAN_INPUT_FEEDER
    bool "Feed an input device's events through input processors (no HID output)"
    default y
    depends on ZMK_POINTING
    depends on DT_HAS_TOUCAN_INPUT_FEEDER_ENABLED

config TOUCAN_INPUT_PROCESSOR_TAP_GUARD
    bool "Tap guard input processor"
    default y
    depends on ZMK_POINTING
    depends on DT_HAS_TOUCAN_INPUT_PROCESSOR_TAP_GUARD_ENABLED
